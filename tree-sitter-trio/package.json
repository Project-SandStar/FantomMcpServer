{
  "name": "tree-sitter-trio",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Trio record format (Project Haystack / Haxall), with Axon injection for src tags",
  "keywords": ["tree-sitter", "trio", "haystack", "haxall", "axon", "parser"],
  "files": ["grammar.js", "queries/*", "src/**", "tree-sitter.json"],
  "author": "Alper",
  "license": "MIT",
  "devDependencies": {
    "tree-sitter-cli": "^0.25.0"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "build": "tree-sitter generate && tree-sitter build --wasm",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "tree-sitter": [
    {
      "scope": "source.trio",
      "file-types": ["trio"],
      "injection-regex": "^trio$"
    }
  ]
}
