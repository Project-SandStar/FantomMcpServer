# Copy to build.env (git ignores it) and set your own absolute paths.
# A value already in the environment always wins over this file.
# No shell expansion here: write full paths.
HAXALL_ROOT=/opt/haxall
FANTOM_ROOT=/opt/fantom
HAYSTACK_DIR=/opt/src/haystack-defs
XETO_DIR=/opt/haxall/xeto
XETO_REPO=/opt/src/xeto
JDK_VERSION=17
