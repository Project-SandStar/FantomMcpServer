{
  "name": "@fantom-mcp/claude-plugin",
  "private": true,
  "version": "1.1.1",
  "description": "Build, test and install scripts for the Fantom MCP Claude Code plugin (dist/ is the plugin).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs --check",
    "test": "bash scripts/test.sh --unit",
    "test:live": "bash scripts/test.sh",
    "install:local": "bash scripts/install-local.sh",
    "uninstall:local": "bash scripts/uninstall-local.sh",
    "doctor": "node dist/bin/doctor.mjs"
  }
}
