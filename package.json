{
  "name": "mcp-fantom",
  "version": "1.0.1",
  "description": "MCP server providing AI assistants access to Fantom language documentation, code examples, and validation tools",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-workflows.cjs",
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http tsx --watch src/index.ts",
    "dev:http:debug": "MCP_TRANSPORT=http tsx --watch --inspect src/index.ts",
    "start:dev": "bash scripts/start-dev.sh",
    "stop:dev": "bash scripts/stop-dev.sh",
    "restart:dev": "bash scripts/restart-dev.sh",
    "start": "node build/index.js",
    "start:http": "MCP_TRANSPORT=http node --expose-gc --max-old-space-size=4096 build/index.js",
    "stop": "bash scripts/stop-server.sh",
    "status": "bash scripts/status-server.sh",
    "daemon:start": "MCP_TRANSPORT=http pm2 start build/index.js --name fantom-mcp --node-args='--expose-gc --max-old-space-size=4096'",
    "daemon:stop": "pm2 stop fantom-mcp",
    "daemon:restart": "pm2 restart fantom-mcp",
    "daemon:logs": "pm2 logs fantom-mcp",
    "dashboard:dev": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm run build",
    "dashboard:install": "cd dashboard && npm install",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "parse": "bun run src/fantom-parser/parser/index.ts",
    "test:search": "node test/smoke/test-search.cjs",
    "test:cache": "node test/smoke/test-cache.cjs",
    "clean": "rm -rf build .cache",
    "prepare": "npm run build",
    "grammars:download": "tsx scripts/download-grammars.ts",
    "test:core": "node test/smoke/test-core.mjs",
    "setup": "bash setup.sh",
    "db:generate": "prisma generate",
    "db:setup": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fantom",
    "fantom-lang",
    "documentation",
    "code-search",
    "haxall"
  ],
  "author": "Anka Labs, Inc.",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@huggingface/transformers": "^3",
    "@ladybugdb/core": "^0.16.1",
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@prisma/client": "^5.22.0",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "flexsearch": "^0.7.43",
    "fs-extra": "^11.2.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-types": "^0.24.8",
    "ignore": "^7.0.5",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "prisma": "^5.22.0",
    "web-tree-sitter": "^0.26.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "commander": "^12.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Project-SandStar/FantomMcpServer.git"
  },
  "homepage": "https://github.com/Project-SandStar/FantomMcpServer#readme",
  "bugs": {
    "url": "https://github.com/Project-SandStar/FantomMcpServer/issues"
  }
}
